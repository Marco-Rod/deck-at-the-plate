# Deck at the Plate — Variables de entorno
# ==========================================
# Copiar este archivo como .env y completar los valores reales.
# NUNCA commitear el archivo .env al repositorio.

# Base de datos PostgreSQL
POSTGRES_USER=game_user
POSTGRES_PASSWORD=game_password
POSTGRES_DB=baseball_game
DATABASE_URL=postgresql://game_user:game_password@db:5432/baseball_game

# JWT — Cambiar por una clave aleatoria segura (mínimo 32 caracteres)
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CAMBIAR_POR_CLAVE_SEGURA_AQUI
